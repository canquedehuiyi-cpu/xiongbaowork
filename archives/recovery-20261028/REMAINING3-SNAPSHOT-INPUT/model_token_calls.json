  "checkConstraints": {
    "model_token_calls_owner": {
      "name": "model_token_calls_owner",
      "value": "\"model_token_calls\".\"tenant_id\" NOT IN ('system', 'platform')"
    },
    "model_token_calls_epoch": {
      "name": "model_token_calls_epoch",
      "value": "\"model_token_calls\".\"execution_epoch\" BETWEEN 1 AND 9007199254740991"
    },
    "model_token_calls_outcome": {
      "name": "model_token_calls_outcome",
      "value": "\"model_token_calls\".\"outcome\" IN ('pending', 'completed', 'stopped', 'unknown')"
    },
    "model_token_calls_usage": {
      "name": "model_token_calls_usage",
      "value": "\"model_token_calls\".\"usage_status\" IN ('unknown', 'partial', 'reported') AND ((\"model_token_calls\".\"usage_status\" = 'reported' AND \"model_token_calls\".\"input_tokens\" IS NOT NULL AND \"model_token_calls\".\"output_tokens\" IS NOT NULL) OR (\"model_token_calls\".\"usage_status\" = 'partial' AND ((\"model_token_calls\".\"input_tokens\" IS NULL) <> (\"model_token_calls\".\"output_tokens\" IS NULL))) OR (\"model_token_calls\".\"usage_status\" = 'unknown' AND \"model_token_calls\".\"input_tokens\" IS NULL AND \"model_token_calls\".\"output_tokens\" IS NULL))"
    },
    "model_token_calls_count_0": {
      "name": "model_token_calls_count_0",
      "value": "\"model_token_calls\".\"input_tokens\" BETWEEN 0 AND 9007199254740991"
    },
    "model_token_calls_count_1": {
      "name": "model_token_calls_count_1",
      "value": "\"model_token_calls\".\"output_tokens\" BETWEEN 0 AND 9007199254740991"
    },
    "model_token_calls_count_2": {
      "name": "model_token_calls_count_2",
      "value": "\"model_token_calls\".\"total_tokens\" BETWEEN 0 AND 9007199254740991"
    },
    "model_token_calls_count_3": {
      "name": "model_token_calls_count_3",
      "value": "\"model_token_calls\".\"reasoning_tokens\" BETWEEN 0 AND 9007199254740991"
    },
    "model_token_calls_count_4": {
      "name": "model_token_calls_count_4",
      "value": "\"model_token_calls\".\"cached_input_tokens\" BETWEEN 0 AND 9007199254740991"
    },
    "model_token_calls_count_5": {
      "name": "model_token_calls_count_5",
      "value": "\"model_token_calls\".\"cache_write_tokens\" BETWEEN 0 AND 9007199254740991"
    },
    "model_token_calls_digests": {
      "name": "model_token_calls_digests",
      "value": "\"model_token_calls\".\"credential_digest\" ~ '^[a-f0-9]{64}$' AND \"model_token_calls\".\"original_model_fingerprint\" ~ '^[a-f0-9]{64}$' AND \"model_token_calls\".\"original_digest\" ~ '^[a-f0-9]{64}$' AND \"model_token_calls\".\"original_digest\" = encode(sha256(convert_to(\"model_token_calls\".\"original_text\",'UTF8')),'hex')"
    },
    "model_token_calls_receipt": {
      "name": "model_token_calls_receipt",
      "value": "(\"model_token_calls\".\"receipt_text\" IS NULL AND \"model_token_calls\".\"receipt_digest\" IS NULL AND \"model_token_calls\".\"outcome\" <> 'completed') OR (\"model_token_calls\".\"receipt_text\" IS NOT NULL AND \"model_token_calls\".\"receipt_digest\" IS NOT NULL AND \"model_token_calls\".\"receipt_digest\" ~ '^[a-f0-9]{64}$' AND \"model_token_calls\".\"receipt_digest\" = encode(sha256(convert_to(\"model_token_calls\".\"receipt_text\",'UTF8')),'hex') AND \"model_token_calls\".\"outcome\" = 'completed' AND \"model_token_calls\".\"observed_at\" IS NOT NULL)"
    }
  },
  "isRLSEnabled": true
