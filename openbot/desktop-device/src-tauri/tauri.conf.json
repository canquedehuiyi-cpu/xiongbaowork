{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "熊宝数字员工 设备端",
  "mainBinaryName": "xiongbao-device",
  "version": "../../package.json",
  "identifier": "com.xiongbao.device",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "熊宝数字员工 设备端",
        "width": 460,
        "height": 600,
        "minWidth": 400,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["procps"] }
    },
    "copyright": "Copyright (c) 2026 熊宝; portions Copyright (c) 2026 CopilotKit (MIT)",
    "category": "Utility",
    "shortDescription": "让熊宝数字员工在这台电脑上工作",
    "longDescription": "熊宝数字员工设备端：输入配对码后，这台电脑主动连接你的熊宝服务器，供数字员工使用本机的文件、命令行和浏览器。本机不开放任何端口。"
  }
}
