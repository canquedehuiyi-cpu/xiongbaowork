# 本机体验模板。不要直接用于公网部署。
# 镜像版本（可选）。Compose 用 OPENBOT_IMAGE 选择镜像，未设置时使用本机构建的 :local；
# README 单容器命令读取同名 shell 变量 OPENBOT_TAG / OPENBOT_IMAGE。
# 生产环境写成 Release 附件 container-images.json 中的 digest：
# OPENBOT_IMAGE=ghcr.io/canquedehuiyi-cpu/xiongbaowork@sha256:<digest>
# OPENBOT_TAG=v0.2.7
# OPENBOT_IMAGE=ghcr.io/canquedehuiyi-cpu/xiongbaowork:v0.2.7
EMBEDDED_POSTGRES=on
OPENBOT_SINGLE_USER=true
OPENBOT_PUBLIC_URL=http://localhost:3772
TENANT_PACKAGE_DIR=../examples/qoderwake
OPENBOT_SELF_HOST_BANNER=false
OPENBOT_RLS_ENFORCE=refuse
# 员工动作的执行位置。镜像是 NODE_ENV=production，不设时默认 device（租户自己配对的设备，
# 没有配对设备就拒绝）。本机体验没有配对设备，所以这里显式用镜像自带的电脑（cloud，开发/演示回退）；
# 正式部署删掉这一行或改成 TENANT_RUNTIME=device。
TENANT_RUNTIME=cloud
# 由 README 命令生成 KEY_ENCRYPTION_KEY，不使用公开固定密钥。
# 内嵌库自动产生 owner / app 口令；不要在这里填 DATABASE_URL。
# 模型接入：配置兼容地址、密钥、BOT_MODEL，或在产品模型库绑定员工。
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_API_KEY=
# BOT_MODEL=
# CopilotKit Intelligence（可选）。不设置时一切照旧，对话始终保存在本部署自己的数据库里。
# 设置了 INTELLIGENCE_API_KEY 才启用：管理后台「自动学习」把 Intelligence 里已发布的学习技能下发给员工。
# 自建 Intelligence 需要 CopilotKit 商业授权（COPILOTKIT_LICENSE_TOKEN）和它自己的 API 地址；
# 托管版只需项目密钥，学习技能与记忆数据会保存在 CopilotKit 云端。
# INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL=https://your-intelligence.example
# COPILOTKIT_LICENSE_TOKEN=
# CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=
