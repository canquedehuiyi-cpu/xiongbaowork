#!/command/with-contenv sh
# The database, when this container is asked to be its own.
#
# `EMBEDDED_POSTGRES=on` turns it on. Off, this service exits 0 immediately and s6 leaves it alone,
# which is how one image serves both shapes without two Dockerfiles.
set -eu
if [ "${EMBEDDED_POSTGRES:-off}" != "on" ]; then
  exec /bin/true
fi
DATA=/var/lib/postgresql/data
BIN=/usr/lib/postgresql/16/bin
# Recheck immediately before starting PostgreSQL; this must not initialize a volume.
/usr/local/bin/bun /etc/s6-overlay/scripts/postgres-volume-version-guard.ts "$DATA" "$BIN" start
exec s6-setuidgid postgres "$BIN/postgres" \
  -D "$DATA" \
  -c listen_addresses=127.0.0.1 \
  -c port=5432
