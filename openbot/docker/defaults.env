RLS_ENFORCE=refuse
SELF_HOST_BANNER=false
IN_CONTAINER=true

# The agent runtime library reports usage to its vendor unless this is set; the server also swaps its capture
# scope for a silent one, so this covers any process that reads the variable directly. The line below it is a
# third party's own variable name (see env-aliases.sh): written as it is, only when the deployment has not set it.
#third-party
COPILOTKIT_TELEMETRY_DISABLED=1
