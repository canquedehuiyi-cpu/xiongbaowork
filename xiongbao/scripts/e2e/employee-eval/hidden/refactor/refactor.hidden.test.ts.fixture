import { expect, test } from "bun:test";
import * as shop from "../src/index";
import { addItem, countPieces, describeCart } from "../src/cart";
import { formatMoney } from "../src/money";
import { biggestLine, orderSummary, orderTotal } from "../src/order";
import { lineTotal } from "../src/price";
import { salesReport, skuRevenue, topSku } from "../src/report";

const pen = { sku: "pen", unitCents: 150, quantity: 3 };
const desk = { sku: "desk", unitCents: 8000, quantity: 1 };
const bulk = { sku: "pen", unitCents: 150, quantity: 20 };

test("lineTotal is the renamed price function, with the bulk discount intact", () => {
  expect(lineTotal(pen)).toBe(450);
  expect(lineTotal({ sku: "pen", unitCents: 150, quantity: 10 })).toBe(1350);
  expect(lineTotal({ sku: "gum", unitCents: 33, quantity: 11 })).toBe(327);
  expect(lineTotal({ sku: "gum", unitCents: 33, quantity: 0 })).toBe(0);
});

test("formatMoney turns cents into yuan with two decimals", () => {
  expect(formatMoney(1999)).toBe("19.99");
  expect(formatMoney(5)).toBe("0.05");
  expect(formatMoney(0)).toBe("0.00");
  expect(formatMoney(10700)).toBe("107.00");
  expect(formatMoney(-250)).toBe("-2.50");
});

test("countPieces counts the quantity of every line", () => {
  expect(countPieces({ items: [] })).toBe(0);
  expect(countPieces({ items: [pen, desk, bulk] })).toBe(24);
});

test("carts keep their old behaviour under the new field name", () => {
  const cart = addItem(addItem({ items: [] }, pen), { ...pen, quantity: 2 });
  expect(cart.items).toEqual([{ sku: "pen", unitCents: 150, quantity: 5 }]);
  expect(describeCart({ items: [pen, { sku: "ink", unitCents: 1999, quantity: 1 }] })).toBe(
    "pen x3 = 4.50\nink x1 = 19.99",
  );
});

test("orders and reports print exactly what they printed before", () => {
  const small = { items: [pen] };
  const big = { items: [desk, bulk] };
  expect(orderTotal(small)).toBe(1250);
  expect(orderTotal(big)).toBe(10700);
  expect(biggestLine(big)?.sku).toBe("desk");
  expect(biggestLine({ items: [] })).toBeUndefined();
  expect(orderSummary(small)).toBe("3 件，合计 12.50 元");
  expect(salesReport([small, big])).toBe(
    "#1: 3 件, 12.50 元\n#2: 21 件, 107.00 元\n总计: 119.50 元",
  );
  expect(salesReport([])).toBe("总计: 0.00 元");
  expect(topSku([small, big])).toBe("pen");
  expect(skuRevenue([small, big], "pen")).toBe(450 + 2700);
});

test("the package entry exports the new names and not the old ones", () => {
  expect(typeof shop.lineTotal).toBe("function");
  expect(typeof shop.formatMoney).toBe("function");
  expect(typeof shop.countPieces).toBe("function");
  expect(shop).not.toHaveProperty("calcPrice");
});
