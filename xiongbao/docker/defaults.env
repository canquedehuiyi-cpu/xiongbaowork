RLS_ENFORCE=refuse
SELF_HOST_BANNER=false
IN_CONTAINER=true

# The agent runtime library reports usage to its vendor unless this is set: it reads the common DO_NOT_TRACK
# switch (as well as one under its own name), and the server also swaps its capture scope for a silent one, so
# this covers any process that reads the variable directly. The line below it is a variable with no XIONGBAO_
# counterpart (see env-defaults.sh): written as it is, only when the deployment has not set it.
#third-party
DO_NOT_TRACK=1
