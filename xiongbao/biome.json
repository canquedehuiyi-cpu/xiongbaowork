{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!.",
      "!.superpowers",
      "!**/.venv*",
      "!app/src/lib/generated/application-config.ts",
      "!app/src/routeTree.gen.ts",
      "!**/target",
      "!server/drizzle"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["toolkit/src/**", "!toolkit/src/runtime/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**"],
                    "message": "The toolkit runs turns without the server. Take what it needs as a port in toolkit/ports.ts instead of importing server code."
                  },
                  {
                    "group": [
                      "./runtime/**",
                      "@xiongbao/toolkit/runtime",
                      "@xiongbao/toolkit/runtime/**"
                    ],
                    "message": "The toolkit core does not depend on the agent runtime library. Code that needs it lives in toolkit/src/runtime and imports the core, not the other way round."
                  },
                  {
                    "group": [
                      "@copilotkit/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "hono",
                      "hono/**"
                    ],
                    "message": "The toolkit core depends on @ag-ui, rxjs, zod and @xiongbao/shared only. Code specific to the agent runtime library goes in toolkit/src/runtime."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["toolkit/src/runtime/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**"],
                    "message": "The runtime adapters run without the server. Take what they need as a port or a constructor option instead of importing server code."
                  },
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "hono",
                      "hono/**"
                    ],
                    "message": "The runtime adapters do not reach the database or the HTTP framework."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": ["mobile/src/check-ins.tsx", "mobile/app/needs-you.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": {
                    "importNames": ["Button"],
                    "message": "Needs you draws its choices as the app's link-coloured text (CardAction in mobile/src/check-ins.tsx). A system Button is a filled, upper-cased bar on Android and the web and looks like no other screen."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
