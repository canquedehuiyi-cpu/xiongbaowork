FROM oven/bun:1.3.14
WORKDIR /app
# The lockfile by name, so a context that lost it fails here instead of resolving the registry afresh.
COPY package.json bun.lock ./
COPY . .
RUN BUN_CONFIG_REGISTRY=https://registry.npmmirror.com bun install --frozen-lockfile
EXPOSE 3001
CMD ["bun", "--env-file=.env", "server/src/index.ts"]
